# =============================================================================
# Laafi — variables d'environnement (modèle, à placer à la racine sous le nom .env.example)
#
# ./scripts/install.sh copie ce modèle vers .env en remplaçant chaque valeur
# « A_GENERER » par un secret aléatoire (openssl rand -hex 32).
# Sans .env, docker compose utilise les valeurs de DÉMONSTRATION écrites dans
# docker-compose.yml (à ne jamais utiliser en production).
#
# ATTENTION : les mots de passe PostgreSQL et les secrets des clients Keycloak
# ne sont appliqués qu'à la PREMIÈRE initialisation (volumes vides). Pour les
# changer ensuite : ./scripts/reset.sh (efface les données) puis install.sh.
# =============================================================================

# --- Accès public ------------------------------------------------------------
# URL publique de la plateforme, sans « / » final. En production : https://…
# (TLS terminé devant la passerelle). En http, seul http://localhost fonctionne
# dans un navigateur : Keycloak pose des cookies « Secure ».
PUBLIC_URL=http://localhost:8888
# Port de la passerelle nginx sur l'hôte (le SEUL port publié).
LAAFI_PORT=8888

# --- PostgreSQL (réseau interne uniquement) ------------------------------------
POSTGRES_PASSWORD=A_GENERER
SYNAPSE_DB_PASSWORD=A_GENERER
KEYCLOAK_DB_PASSWORD=A_GENERER
LAAFI_DB_PASSWORD=A_GENERER

# --- Keycloak ----------------------------------------------------------------
# Administrateur technique du realm « master » (console /auth/admin non publiée par
# la passerelle : utiliser « docker compose exec keycloak /opt/keycloak/bin/kcadm.sh »).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=A_GENERER
# Secret du client OIDC « synapse » (partagé Keycloak <-> Synapse).
KEYCLOAK_SYNAPSE_SECRET=A_GENERER
# Secret du client « laafi-backend » (compte de service : API d'administration Keycloak).
KEYCLOAK_BACKEND_SECRET=A_GENERER
KEYCLOAK_LOG_LEVEL=INFO

# --- Synapse (Matrix) --------------------------------------------------------
# Nom du serveur Matrix : identifiants @prenom.nom:laafi.local. NE PLUS CHANGER après
# le premier démarrage (il est inscrit dans chaque identifiant et chaque événement).
SYNAPSE_SERVER_NAME=laafi.local
# Secret partagé d'inscription (sert uniquement à créer le compte de service).
SYNAPSE_REGISTRATION_SHARED_SECRET=A_GENERER
SYNAPSE_MACAROON_SECRET_KEY=A_GENERER
SYNAPSE_FORM_SECRET=A_GENERER
# Mot de passe du compte administrateur de service @laafi-service (utilisé par le backend).
SYNAPSE_SERVICE_PASSWORD=A_GENERER
# Taille maximale d'une pièce jointe (chiffrée). La passerelle accepte jusqu'à 100 Mo.
SYNAPSE_MAX_UPLOAD_SIZE=100M
