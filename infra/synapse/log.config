# Journalisation Synapse minimale : niveau WARNING, sortie console uniquement.
# Les requêtes HTTP (qui contiennent identifiants et adresses IP) ne sont pas journalisées.
version: 1
formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(message)s'
handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
loggers:
  synapse.storage.SQL:
    level: WARNING
  synapse.access.http.8008:
    level: ERROR
root:
  level: WARNING
  handlers: [console]
disable_existing_loggers: false
